# ==============================================================================
# NIAT AI ADMISSION COPILOT — ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================

# LLM Provider Configuration
# Set your Groq API Key (Sign up for free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Alternate/Optional AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database Configuration
# Local Development: SQLite with asynchronous aiosqlite
DATABASE_URL=sqlite+aiosqlite:///niat_copilot.db

# Production Deployment: Supabase PostgreSQL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ==============================================================================
# AUTOMATION ENGINE PROVIDERS (Default: zero-cost mock mode)
# ==============================================================================
# Messaging Provider Mode: "mock" (default, runs locally with simulated delivery) or "live"
MESSAGING_MODE=mock
WHATSAPP_PROVIDER=meta # "meta" or "twilio"

# Meta WhatsApp Cloud API (Required only when MESSAGING_MODE=live and WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=100609...
META_VERIFY_TOKEN=niat_copilot_webhook_verify_secret_token

# Twilio WhatsApp API (Required only when MESSAGING_MODE=live and WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+14155238886

# Voice Provider Mode: "mock" (default, simulates calls & transcripts) or "live"
VOICE_MODE=mock
VOICE_PROVIDER=vapi # "vapi" or "mock"

# Vapi Telephony (Required only when VOICE_MODE=live)
VAPI_API_KEY=vapi-api-key-...
VAPI_PHONE_NUMBER_ID=...
VAPI_ASSISTANT_ID=...

# Server Settings
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]
